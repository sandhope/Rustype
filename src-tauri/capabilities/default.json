{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Rustype desktop app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "shell:default",
    "store:default",
    "window-state:default",
    "fs:default",
    "fs:read-all",
    "fs:write-all",
    "fs:scope-home",
    "fs:scope-desktop",
    "fs:scope-document",
    "fs:scope-download",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-set-decorations"
  ]
}
